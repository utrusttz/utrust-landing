---

<section id="factory-specs" aria-labelledby="specs-heading" class="py-16 bg-slate-50 border-t border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Table 1: Factory Production Specifications -->
    <div class="mb-14">
      <div class="max-w-3xl mb-6">
        <div class="inline-flex items-center gap-2 bg-orange-100 text-orange-950 border border-orange-200 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-2">
          <span>🏭 B2B Industrial Specifications</span>
        </div>
        <h2 id="specs-heading" class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight">
          {t.specsTitle}
        </h2>
        <p class="mt-2 text-sm text-slate-600">
          {t.specsSubtitle}
        </p>
      </div>

      <div class="overflow-x-auto bg-white rounded-2xl border border-slate-200 shadow-xs">
        <table class="w-full text-left border-collapse text-xs sm:text-sm">
          <thead>
            <tr class="bg-slate-900 text-white font-mono uppercase text-[11px] tracking-wider">
              <th scope="col" class="p-4 sm:p-4.5 border-b border-slate-800">{t.thProduct}</th>
              <th scope="col" class="p-4 sm:p-4.5 border-b border-slate-800">{t.thFabric}</th>
              <th scope="col" class="p-4 sm:p-4.5 border-b border-slate-800 whitespace-nowrap">{t.thCapacity}</th>
              <th scope="col" class="p-4 sm:p-4.5 border-b border-slate-800">{t.thTerms}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-700">
            <tr class="hover:bg-slate-50/70 transition-colors">
              <td class="p-4 sm:p-4.5 font-bold text-slate-950">
                {t.tshirtName}
              </td>
              <td class="p-4 sm:p-4.5">
                {t.tshirtFabric}
              </td>
              <td class="p-4 sm:p-4.5 font-mono font-semibold text-[#d46f24] whitespace-nowrap">
                {t.tshirtCap}
              </td>
              <td class="p-4 sm:p-4.5 text-slate-600">
                {t.tshirtTerms}
              </td>
            </tr>
            <tr class="hover:bg-slate-50/70 transition-colors">
              <td class="p-4 sm:p-4.5 font-bold text-slate-950">
                {t.boxerName}
              </td>
              <td class="p-4 sm:p-4.5">
                {t.boxerFabric}
              </td>
              <td class="p-4 sm:p-4.5 font-mono font-semibold text-[#d46f24] whitespace-nowrap">
                {t.boxerCap}
              </td>
              <td class="p-4 sm:p-4.5 text-slate-600">
                {t.boxerTerms}
              </td>
            </tr>
            <tr class="hover:bg-slate-50/70 transition-colors">
              <td class="p-4 sm:p-4.5 font-bold text-slate-950">
                {t.poloName}
              </td>
              <td class="p-4 sm:p-4.5">
                {t.poloFabric}
              </td>
              <td class="p-4 sm:p-4.5 font-mono font-semibold text-[#d46f24] whitespace-nowrap">
                {t.poloCap}
              </td>
              <td class="p-4 sm:p-4.5 text-slate-600">
                {t.poloTerms}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Table 2: Cross-Border Sourcing Corridors -->
    <div>
      <div class="max-w-3xl mb-6">
        <div class="inline-flex items-center gap-2 bg-emerald-100 text-emerald-950 border border-emerald-200 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-2">
          <span>🌍 SADC & EAC Regional Export Hub</span>
        </div>
        <h3 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          {t.corridorTitle}
        </h3>
        <p class="mt-2 text-sm text-slate-600">
          {t.corridorSubtitle}
        </p>
      </div>

      <div class="overflow-x-auto bg-white rounded-2xl border border-slate-200 shadow-xs mb-8">
        <table class="w-full text-left border-collapse text-xs sm:text-sm">
          <thead>
            <tr class="bg-slate-900 text-white font-mono uppercase text-[11px] tracking-wider">
              <th scope="col" class="p-4 sm:p-4.5 border-b border-slate-800">{t.thCountry}</th>
              <th scope="col" class="p-4 sm:p-4.5 border-b border-slate-800">{t.thCorridor}</th>
              <th scope="col" class="p-4 sm:p-4.5 border-b border-slate-800">{t.thTradeRegime}</th>
              <th scope="col" class="p-4 sm:p-4.5 border-b border-slate-800 whitespace-nowrap">{t.thTransitTime}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-700">
            {corridors.map((c) => (
              <tr class="hover:bg-slate-50/70 transition-colors">
                <td class="p-4 sm:p-4.5 font-bold text-slate-950 whitespace-nowrap">
                  {c.country}
                </td>
                <td class="p-4 sm:p-4.5 text-slate-600">
                  {c.border}
                </td>
                <td class="p-4 sm:p-4.5 text-slate-700">
                  {c.protocol}
                </td>
                <td class="p-4 sm:p-4.5 font-mono font-semibold text-emerald-700 whitespace-nowrap">
                  {c.time}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 p-5 bg-orange-50/80 rounded-2xl border border-orange-200/80">
        <div class="text-xs sm:text-sm text-slate-700 font-medium">
          <span class="font-bold text-slate-950">Showroom & Office:</span> 2nd Floor, Nasra Tower, 21 Kisarawe St, Kariakoo, Dar es Salaam <br />
          <span class="font-bold text-slate-950">Factory Plant:</span> 24804, Lingato Street, Kisarawe 2, Kigamboni, Dar Es Salaam
        </div>
        <div class="flex items-center gap-3 w-full sm:w-auto">
          <a
            href="https://wa.me/255761644444?text=Habari%20Utrust!%20Naomba%20katalogi%20na%20bei%20za%20jumla%20(Wholesale%20RFQ)."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#d46f24] hover:bg-[#b85816] text-white px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all shadow-sm whitespace-nowrap"
          >
            <span>{t.ctaWholesale}</span>
          </a>
        </div>
      </div>

