---
// src/pages/index.astro
// Astro page: renders the full Utrust Clothing Tanzania Limited landing page.
// The entire React tree is mounted as a single island (client:load) so the
// LanguageProvider context is shared across all child components.
import App from '../components/App';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#d46f24" />

    <!-- Primary SEO -->
    <title>Utrust Clothing Tanzania Limited | Factory-Direct Apparel Manufacturer Dar es Salaam</title>
    <meta name="description" content="Tanzania's largest industrial textile mill. Replace Mitumba with 100% brand-new, ISO 9001:2024 certified apparel. 2.8M units/month. Wholesale B2B accounts open. Factory direct from Dar es Salaam." />
    <meta name="keywords" content="Tanzania clothing manufacturer, factory direct apparel, B2B wholesale Tanzania, replace mitumba, Dar es Salaam textile mill, East Africa apparel" />
    <link rel="canonical" href="https://utrust.co.tz/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://utrust.co.tz/" />
    <meta property="og:title" content="Utrust Clothing Tanzania Limited | Factory-Direct Apparel" />
    <meta property="og:description" content="Tanzania's premier industrial apparel manufacturer. ISO 9001:2024. 2.8M units/month. Replace Mitumba with factory-direct certified apparel." />
    <meta property="og:image" content="/showcase/utrust-product-1.jpg" />
    <meta property="og:locale" content="en_TZ" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Utrust Clothing Tanzania Limited" />
    <meta name="twitter:description" content="Factory-direct apparel manufacturer in Dar es Salaam. ISO certified. 2.8M units/month." />
    <meta name="twitter:image" content="/showcase/utrust-product-1.jpg" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Google Font: Fredoka (Utrust brand font) — preconnect for speed -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Cloudflare Web Analytics (optional — add token when domain is live) -->
    <!-- <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "YOUR_TOKEN"}'></script> -->
  </head>
  <body class="bg-white text-slate-950 selection:bg-orange-100 selection:text-orange-950">
    <!--
      Single Astro Island with client:load.
      All React state (language switcher, calculators, forms, carousel)
      is managed inside this island, keeping the HTML shell 0KB JS.
    -->
    <App client:load />
  </body>
</html>
