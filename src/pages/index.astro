      "email": "utrustclothingtz@gmail.com",
      "telephone": "+255761644444",
      "priceRange": "$$",
      "currenciesAccepted": "TZS, USD",
      "paymentAccepted": "Cash, Bank Transfer, M-Pesa, Tigo Pesa, Airtel Money",
      "address": {
